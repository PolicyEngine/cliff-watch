{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd frontend && bun install",
  "buildCommand": "cd frontend && bun run build",
  "outputDirectory": "frontend/out",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "header", "key": "x-forwarded-host", "value": "cliff-watch\\.vercel\\.app" }],
      "destination": "https://www.policyengine.org/us/cliffwatch",
      "permanent": true
    },
    {
      "source": "/((?!api/).*)",
      "has": [{ "type": "header", "key": "x-forwarded-host", "value": "cliff-watch\\.vercel\\.app" }],
      "destination": "https://www.policyengine.org/us/cliffwatch/$1",
      "permanent": true
    }
  ],
  "functions": {
    "api/calculate.py": {
      "maxDuration": 60
    },
    "api/series.py": {
      "maxDuration": 60
    },
    "api/metadata.py": {
      "maxDuration": 10
    },
    "api/households.py": {
      "maxDuration": 60
    }
  }
}
