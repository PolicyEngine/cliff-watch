{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd frontend && bun install",
  "buildCommand": "cd frontend && bun run build",
  "outputDirectory": "frontend/out",
  "functions": {
    "api/calculate.py": {
      "maxDuration": 120
    },
    "api/series.py": {
      "maxDuration": 120
    },
    "api/metadata.py": {
      "maxDuration": 10
    },
    "api/households.py": {
      "maxDuration": 120
    }
  }
}
